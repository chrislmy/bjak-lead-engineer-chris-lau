# Generator (OpenAI-compatible). Defaults talk to local Ollama.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.1:8b

# DeepEval judge. Same Ollama daemon; this slice uses llama3.1:8b for ask and judge.
JUDGE_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# Print model thinking to stderr for `ask` (same as `ask --think`).
# ASK_SHOW_THINKING=1
